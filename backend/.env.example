# AWS Configuration - Bedrock runtime + KB run in ap-south-1
AWS_REGION=ap-south-1

# Knowledge Base Configuration - KB runs in ap-south-1
KB_REGION=ap-south-1
KB_KNOWLEDGE_BASE_ID=HN2QJNTWYX
KB_MODEL_ARN=arn:aws:bedrock:ap-south-1:417780655467:inference-profile/apac.amazon.nova-micro-v1:0
KB_CHUNK_CONFIDENCE_THRESHOLD=0.8
KB_MIN_HIGH_CONFIDENCE_CHUNKS=1

# Server
PORT=3000
HOST=0.0.0.0
# Sarvam API key
SARVAM_API_KEY=your_sarvam_api_key
# Sarvam STT & TTS models (SDK-valid IDs)
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Bedrock conversational LLM
LLM_MODEL=apac.amazon.nova-pro-v1:0

# OpenAI fallback (used automatically if Bedrock throttles or quota fails)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

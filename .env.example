# ==============================================================================
# Central Configuration Example - Multilingual Indic Voicebot for Jain Sales
# Copy this file to .env and fill in your credentials
# ==============================================================================

# ── AWS Connection & Credentials ──────────────────────────────────────────────
# AWS Account ID and primary deployment region
AWS_ACCOUNT_ID=your_aws_account_id
AWS_DEFAULT_REGION=ap-south-1

# ── Amazon Bedrock LLM / Knowledge Base Settings ──────────────────────────────
# Region where Bedrock model & Knowledge Base are hosted
KB_REGION=ap-south-1

# Amazon Bedrock Knowledge Base ID
KB_KNOWLEDGE_BASE_ID=your_knowledge_base_id

# Amazon Bedrock LLM Model ID / Inference Profile ARN for RAG Retrieval
# Defaults to Nova Micro inference profile ARN
KB_MODEL_ARN=arn:aws:bedrock:ap-south-1:your_aws_account_id:inference-profile/apac.amazon.nova-micro-v1:0

# Amazon Bedrock LLM Model ID for conversational generation
LLM_MODEL=apac.amazon.nova-pro-v1:0

# ── Sarvam AI API Configurations ──────────────────────────────────────────────
# Sarvam AI subscription key (used for Speech-to-Text & Text-to-Speech)
SARVAM_API_KEY=your_sarvam_api_key

# Sarvam AI STT & TTS models
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# ── Backend Host & Port ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# CORS allowed origins (comma-separated list, e.g., https://example.com,https://app.example.com or * for dev)
ALLOWED_ORIGINS=*
